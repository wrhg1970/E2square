# Copia este archivo a .env.local y reemplaza los valores.
# Con Supabase local: ejecuta `npx supabase start` y usa la URL y la anon key que imprime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar-con-anon-key

# Google Workspace (Gmail y Calendar). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# Sin estas tres variables la pantalla Integraciones muestra "pendiente" y el resto del CRM funciona igual.
GOOGLE_CLIENT_ID=reemplazar.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=reemplazar-con-client-secret
# 32 bytes aleatorios en base64 (ver README, sección Google).
GOOGLE_TOKEN_KEY=reemplazar-con-llave-base64-de-32-bytes
# Clave de la sincronización nocturna de Gmail: se genera en Integraciones (administrador) y Vercel la manda a /api/cron/gmail.
CRON_SECRET=reemplazar-con-la-clave-generada-en-integraciones

# Inteligencia artificial (opcional). Elige un proveedor: gemini o anthropic. Solo servidor.
# Sin estas variables, "Resumen y riesgos (IA)" se muestra como pendiente.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=reemplazar-con-clave-de-ai-studio
# ANTHROPIC_API_KEY=reemplazar-con-clave-de-console-anthropic
# Opcional: modelo distinto al predeterminado (gemini-3.8-flash o claude-opus-5-5), p. ej. claude-haiku-5-5 o claude-sonnet-5-5.
# AI_MODEL=

# WhatsApp Cloud API (opcional, solo servidor): token de usuario de sistema de Meta para ENVIAR. Recibir no lo necesita.
# WHATSAPP_ACCESS_TOKEN=token-ficticio-de-meta
