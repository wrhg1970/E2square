# Copia este archivo a .env.local y reemplaza los valores.
# Con Supabase local: ejecuta `npx supabase start` y usa la URL y la anon key que imprime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar-con-anon-key

# Google Workspace (Gmail y Calendar). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# Sin estas tres variables la pantalla Integraciones muestra "pendiente" y el resto del CRM funciona igual.
GOOGLE_CLIENT_ID=reemplazar.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=reemplazar-con-client-secret
# 32 bytes aleatorios en base64 (ver README, sección Google).
GOOGLE_TOKEN_KEY=reemplazar-con-llave-base64-de-32-bytes
